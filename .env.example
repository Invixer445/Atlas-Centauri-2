# ─────────────────────────────────────────────────────────────────────────────
# ATLAS SOLAR — environment configuration
# Copy this file to ".env" and fill in your own values. NEVER commit .env.
# Load it with your process manager, or:  export $(grep -v '^#' .env | xargs)
# ─────────────────────────────────────────────────────────────────────────────

# ── MARKET DATA + EXECUTION (Alpaca) ─────────────────────────────────────────
# ATLAS uses Alpaca for BOTH data and trading. The SAME keys grant both.
# Get keys at https://app.alpaca.markets (paper keys work for data + paper trading).
# IMPORTANT: paper keys and live keys are DIFFERENT. Match them to ALPACA_PAPER below.
APCA_API_KEY_ID=your_alpaca_key_id_here
APCA_API_SECRET_KEY=your_alpaca_secret_key_here

# Real-time data feed:
#   iex  → free, real-time IEX trades (DEFAULT, correct for the free plan)
#   sip  → full consolidated tape (requires a paid Alpaca market-data plan)
ALPACA_DATA_FEED=iex

# Server port (default 3000)
PORT=3000

# ── STRATEGY (v11.2 — volatility-normalized, multi-factor, regime-adaptive) ───
# Strategy gate: "on" (default) enforces the EMA(9/21) + RSI(14) + ADX entry
# rules below. "off" lets the weighted score alone decide (not recommended).
STRATEGY_GATE=on

# Mean reversion: "on" (default) lets the bot FADE oversold/overbought extremes
# when ADX says the market is ranging (no trend). "off" = momentum-only.
MEAN_REVERSION=on

# The numbers below have sensible built-in defaults and rarely need changing.
# They are documented here so you understand what the engine is doing. To tune,
# uncomment and set. (Edits to these require code knowledge — see GUIDE_2.)
#
#   ATR-anchored risk geometry (stops/targets scale with each stock's volatility):
#     ATR_STOP_MULT   = 2.2    stop sits 2.2×ATR from entry
#     ATR_TARGET_MULT = 4.6    first target ≈ 4.6×ATR  → ~2.1:1 reward:risk
#     MIN_RR          = 1.8    reject any setup below this reward:risk
#     ATR_TRAIL_MULT  = 2.0    trail by 2.0×ATR once in profit
#   ADX regime filter:
#     ADX_TREND       = 23     ADX ≥ 23 → trending → momentum entries
#     ADX_RANGE       = 18     ADX ≤ 18 → ranging  → mean-reversion entries
#   Position sizing (CONSTANT DOLLAR-RISK + ¼-Kelly overlay):
#     RISK_PER_TRADE_BASE = 0.010   risk 1.0% of the trading pool per trade
#     RISK_PER_TRADE_MAX  = 0.020   absolute ceiling, never exceeded (2.0%)
#     KELLY_FRACTION      = 0.25    ¼-Kelly applied to MEASURED edge (≥20 trades)
# These are read at startup from STRATEGY in server.js; the env overrides are
# optional hooks for advanced tuning.

# ── EXECUTION MODE ───────────────────────────────────────────────────────────
# LIVE_TRADING=false  → pure internal simulation, no broker orders (DEFAULT, SAFE)
# LIVE_TRADING=true   → route orders to the broker below (after ATLAS risk checks)
LIVE_TRADING=false

# AUTONOMOUS_TRADING=true  → ATLAS opens its own positions from its engine (DEFAULT)
# AUTONOMOUS_TRADING=false → pure executor: entries come ONLY from TradingView webhook
AUTONOMOUS_TRADING=true

# ── BROKER (only used when LIVE_TRADING=true) ────────────────────────────────
# BROKER=paper   → internal acknowledger, no real account (test the bridge)
# BROKER=alpaca  → Alpaca Markets REST (paper or live by ALPACA_PAPER below)
BROKER=paper

# ALPACA_PAPER=true  → https://paper-api.alpaca.markets (fake money, DEFAULT)
# ALPACA_PAPER=false → https://api.alpaca.markets  (REAL MONEY)
# (Broker order routing reads APCA_API_KEY_ID / APCA_API_SECRET_KEY above —
#  the same keys used for data. Use paper keys for paper, live keys for live.)
ALPACA_PAPER=true

# ── TRADINGVIEW WEBHOOK (optional) ───────────────────────────────────────────
# Shared secret that TradingView alerts must include as "passphrase".
# Leave blank to disable the webhook entirely.
TRADINGVIEW_WEBHOOK_SECRET=

# Optional admin token for state-MUTATING API endpoints (/api/emergency, /api/aplus,
# /api/retrain, /api/reconcile, /api/intel/analyze). Unset = open (fine locally).
# SET THIS on any public deployment (Railway etc.) — otherwise anyone who finds the
# URL can resume a halted bot or toggle aggressive mode.
# Pass it as ?token=... or an X-Admin-Token header (Luna's Retrain button needs ?token=).
# ADMIN_TOKEN=choose-a-long-random-string


# ── CENTAURI INTELLIGENCE (optional — without a key, the bot runs in pure ────
# ── technical mode, identical to ATLAS Solar) ────────────────────────────────
# Provider 1 (RECOMMENDED, FREE): Groq — console.groq.com → API Keys → create.
# No credit card. Free tier: ~1,000 req/day on llama-3.3-70b-versatile; ATLAS
# uses at most ~80/day. Runs on Groq's cloud — your computer can be off.
GROQ_API_KEY=

# Provider 2 (optional, paid): Anthropic Claude — console.anthropic.com.
# ~$0.01–0.05/call. Used only if GROQ_API_KEY is unset (or AI_PROVIDER forces it).
ANTHROPIC_API_KEY=

# Force a provider ('groq' or 'anthropic'). Default: groq if its key exists.
AI_PROVIDER=

# Model override (defaults: groq → llama-3.3-70b-versatile, anthropic → claude-sonnet-4-6)
AI_MODEL=

# News poll cadence in ms (min 60000). Default 5 minutes, 8:00–16:00 ET only.
NEWS_POLL_MS=300000

# Hard cap on LLM calls per rolling hour (cost/rate-limit control)
AI_MAX_CALLS_PER_HOUR=40        # both engines reason via LLM each cycle (Venus posture + Jupiter self-check); Groq free-tier handles this. Lower it to economize.

# ── Venus research (SEC EDGAR 13F institutional holdings) ────────────────────
# Venus scans SEC EDGAR for 13F filings to see what large institutions hold. The
# SEC asks every automated client to identify itself with a real User-Agent that
# includes a contact email. Set yours here (e.g. "YourName your@email.com").
# Research still runs without it, but setting a real UA is the polite/expected way.
# NOTE: 13F data is quarterly and lags ~45 days — it's a watchlist/bias signal, not
# intraday timing. News + real-time relative volume cover the fast-moving side.
SEC_USER_AGENT=

# Minimum AI conviction (0.5–0.9) to add a non-core symbol to the dynamic watchlist
AI_CONVICTION_MIN=0.65

# Max score adjustment the AI can apply (0–0.20). It nudges the technical score;
# it can never bypass the strategy gate or risk pipeline.
AI_SIGNAL_WEIGHT=0.12

# Dynamic watchlist: "on" lets high-conviction news signals add symbols (max below)
DYNAMIC_WATCHLIST=on
DYNAMIC_MAX_SYMBOLS=8

# ── LEARNING MODELS (v11.4 — real online ML; defaults are sensible, rarely touched) ─
# Venus's win-probability model (online logistic regression). It learns which trade
# conditions predict winners and scales sizing (bounded 0.5x–1.5x, still capped at 2%).
# Set VENUS_MODEL=off to disable the model's influence on sizing/scoring entirely.
VENUS_MODEL=on
# Learning rate — higher adapts faster but is noisier.
VENUS_MODEL_LR=0.06
# L2 regularization — higher keeps weights more conservative (good for small samples).
VENUS_MODEL_L2=0.001
# Pseudocount — how many resolved trades before the model reaches full influence.
VENUS_MODEL_PSEUDOCOUNT=25
# Jupiter's calibration model learning rate (how fast it corrects over/underconfidence).
JUPITER_CALIB_LR=0.05

# NOTE: model weights are saved in the state file (atlas-solar-state.json) and reload
# on restart, so learning accumulates across runs. On Railway (or any ephemeral host)
# attach a PERSISTENT VOLUME, or the models reset to untrained on every redeploy.

# ── SPECIALIZATION TRAINING ──────────────────────────────────────────────────
# The AIs learn online automatically. To make them HIGHLY SPECIALIZED, replay their
# accumulated experience over many epochs:
#   • CLI (bot stopped):   node train.js            (see node train.js --help)
#   • Live (no restart):   curl -X POST "http://localhost:3000/api/retrain?epochs=20"
# Both read/write the learned weights in the state file above, so specialization
# persists across restarts. More real trades ⇒ better specialization (never a profit
# guarantee). The model env vars above (VENUS_MODEL_*, JUPITER_CALIB_LR) also apply to
# training.
